    "start": "cd server && npm start",
    "seed": "cd server && npm run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.0"
  }
}
