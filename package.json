{
  "name": "tether-gold-exchange",
  "version": "1.0.0",
  "description": "TetherGoldExchange - Secure cryptocurrency trading platform",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
